{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dousville/log",
  "title": "Payload log",
  "type": "object",
  "required": ["level", "text"],
  "additionalProperties": false,
  "properties": {
    "level": { "enum": ["info", "warn", "error"] },
    "text": { "type": "string", "minLength": 1 }
  }
}
